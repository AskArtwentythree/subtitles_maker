.env
__pycache__/
*.pyc
.venv/
venv/
output/
samples/*
!samples/.gitkeep

# Кэш скиллов Cursor / локи — не для деплоя
.agents/
skills-lock.json

# Случайные/мусорные файлы
photo_*.jpg

# HyperFrames-эксперименты: ботом не используются, тащат тяжёлые медиа
hf-effects/

# Remotion: рантайм-копии исходников и тестовые рендеры (генерятся на лету).
# Игнорируем содержимое public/, но НЕ саму папку — иначе нельзя переисключить
# вшитые шрифты (git не заходит в полностью исключённый каталог).
my-video/public/*
!my-video/public/fonts/
my-video/*.mp4
